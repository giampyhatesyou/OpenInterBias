# OpenInterBias Environment Configuration
# Copy this file to .env or set these variables on your machine/cluster
# Then update the paths according to your system setup

# Llama-2 Model Paths
export OPENBIAS_LLAMA_PATH="/path/to/llama-2-7b-chat"
export OPENBIAS_LLAMA_TOKENIZER_PATH="/path/to/llama-2-7b-chat/tokenizer.model"

# Dataset Paths
export OPENBIAS_COCO_PATH="/path/to/coco"
export OPENBIAS_FLICKR30K_PATH="/path/to/flickr_30k"
export OPENBIAS_FFHQ_PATH="/path/to/FFHQ"
export OPENBIAS_WINOBIAS_PATH="/path/to/winobias"

# Optional: LLaVA Model Paths (if different from defaults in utils/llava/weights/)
# export OPENBIAS_LLAVA_7B_PATH="/path/to/llava-v1.5-7b"
# export OPENBIAS_LLAVA_13B_PATH="/path/to/llava-v1.5-13b"

# EXAMPLE for a cluster setup:
# export OPENBIAS_LLAMA_PATH="/scratch/models/llama-2-7b-chat"
# export OPENBIAS_COCO_PATH="/data/coco"
# export OPENBIAS_FLICKR30K_PATH="/data/flickr_30k"

# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Update paths in .env according to your machine
# 3. Source the environment before running scripts:
#    source .env
#    python bias_proposals.py --workers 6 --dataset 'coco'
#
# OR set variables on-the-fly:
#    OPENBIAS_LLAMA_PATH="/my/path" python bias_proposals.py --workers 6 --dataset 'coco'
