# =============================================================================
# Shared environment for all cluster jobs.
#
# Copy to cluster/_common.local.env and edit. The .local.env file is
# gitignored (see *.local.* in .gitignore).
# =============================================================================

# --- paths on the cluster ---
export OPENBIAS_REPO="TODO_/path/to/OpenInterBias"
export OPENBIAS_VENV="TODO_/path/to/venv"           # e.g. .../openbias
export OPENBIAS_RUN_NAME="TODO_run-name"            # matches runs/<this>/
export OPENBIAS_RUN_DIR="${OPENBIAS_REPO}/runs/${OPENBIAS_RUN_NAME}"

# --- model weights ---
export LLAMA2_WEIGHTS="TODO_/path/to/llama-2-7b-chat"
export LLAMA2_TOKENIZER="${LLAMA2_WEIGHTS}/tokenizer.model"
export LLAVA_WEIGHTS="TODO_/path/to/llava-v1.5-13b"

# --- datasets ---
export COCO_ROOT="TODO_/path/to/coco"
export FLICKR30K_ROOT="TODO_/path/to/flickr_30k"

# --- runtime knobs ---
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export HF_HOME="${HF_HOME:-${OPENBIAS_REPO}/.hf_cache}"
export TRANSFORMERS_CACHE="${HF_HOME}"
export TOKENIZERS_PARALLELISM=false

# --- sanity ---
if [ ! -d "${OPENBIAS_REPO}" ]; then
  echo "ERROR: OPENBIAS_REPO does not exist: ${OPENBIAS_REPO}"
  return 1 2>/dev/null || exit 1
fi
mkdir -p "${OPENBIAS_RUN_DIR}/logs" "${OPENBIAS_RUN_DIR}/outputs"
